{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "./App.js",
  "scripts": {
    "assets:generate": "node ./scripts/generate-assets.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "android:native": "expo prebuild --platform android",
    "android:native:clean": "expo prebuild --platform android --clean",
    "android:apk": "expo prebuild --platform android && cd android && gradlew.bat assembleRelease",
    "android:aab": "expo prebuild --platform android && cd android && gradlew.bat bundleRelease",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "npm run assets:generate && expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "54.0.0",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-web": "^0.21.0"
  }
}
